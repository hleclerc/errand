Bootstrap: docker
From: ubuntu:24.04

# Open MPI from Ubuntu is built with PMIx: `srun --mpi=pmix` on the host starts its ranks.
# errand rebuilds the image when this file changes ( `errand setup --env cluster` ).

%post
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        python3 python3-numpy python3-mpi4py openmpi-bin
    ln -sf /usr/bin/python3 /usr/local/bin/python

%environment
    export PYTHONUNBUFFERED=1
    # Each rank enters the image on its own, in a user namespace of its own: the ranks of a node cannot
    # map each other's memory ( CMA ), and Open MPI says so for every rank unless told to copy instead.
    export OMPI_MCA_btl_vader_single_copy_mechanism=none
